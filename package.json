{
  "name": "tiny-ocr-front",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run build && bun --watch backend/server.ts",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "build": "vue-tsc -p frontend/tsconfig.json && tsc -p tsconfig.node.json && vite build --config frontend/vite.config.ts",
    "start": "bun backend/server.ts",
    "test": "bun test backend/tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:live": "OCR_LIVE=1 playwright test --grep 'real backend'",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1137.0",
    "@aws-sdk/s3-request-presigner": "^3.1137.0",
    "@lucide/vue": "^1.47.0",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "pdfjs-dist": "^6.3.289",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  }
}
