# Bun
PORT=3001

# Servicio Python OCR
OCR_SERVICE_URL=http://localhost:3000

# Frontend compilado
STATIC_ROOT=./frontend/dist

# RustFS / S3
# Debe ser accesible desde el navegador al seguir la URL firmada.
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_BUCKET=ocr-results
RUSTFS_REGION=us-east-1

# Nunca pongas credenciales reales en este archivo.
RUSTFS_ACCESS_KEY=change-me-access-key
RUSTFS_SECRET_KEY=change-me-secret-key

# Tiempo de validez de las URLs firmadas
RESULT_URL_EXPIRES_SECONDS=60
